{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "**",
        "destination": "https://www.leadbellus.com.br/:path*",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "leadbellus",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
