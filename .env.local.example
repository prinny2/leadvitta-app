# ===== RespondeEstética IA — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha.
# O app FUNCIONA SEM NENHUMA chave (modo demonstração): a UI roda, as respostas
# vêm de exemplos e os dados ficam salvos no navegador. Preencha para liberar o
# modo real (IA de verdade + login + dados na nuvem).

# --- IA (OpenAI / Anthropic) ------------------------------------------------
# OpenAI: crie a chave em https://platform.openai.com/api-keys
# Anthropic: crie a chave em https://console.anthropic.com (Settings -> API Keys)
# Sem ela => respostas de exemplo (mock).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado para gerar as respostas (opcional).
# Se houver OpenAI, padrão = gpt-4o-mini. Sem OpenAI, padrão = claude-haiku-4-5.
AI_MODEL=gpt-4o-mini

# --- Firebase (login + banco de dados) --------------------------------------
# Crie um projeto em https://console.firebase.google.com e habilite:
#   Authentication (Email/Senha + Google) e Firestore Database.
# Project Settings -> General -> Your apps -> SDK setup: copie as chaves abaixo.
# Auth oficial do v1 = Firebase Auth. Não existe fluxo Auth0 ativo neste repo.
# Sem isso => login dispensado e dados salvos no navegador (modo demonstração).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor: Stripe webhook + Zapier autenticado)
# No Cloud Run, prefira a service account anexada ao serviço (ADC) para evitar
# manter um JSON longo em Secret Manager; fora do GCP, use as opções abaixo.
# Em host externo, cole o JSON inteiro em FIREBASE_SERVICE_ACCOUNT_JSON
# ou use a versão base64 se o painel/CLI escapar caracteres/multiline.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa por campos:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (checkout + webhook) --------------------------------------------
# Crie os produtos/preços no Stripe e copie os Price IDs (price_...).
# Lançamento atual: Start R$97/mês disponível para venda.
# Pro e Premium ficam em lista de espera; configure os IDs deles só quando abrir.
# Todos os Price IDs usados aqui precisam ser "recurring" e o modo = subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_PRICE_ID_START=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- WhatsApp (provedor) ----------------------------------------------------
# Qual provedor de WhatsApp usar: "twilio" (padrão) ou "dialog360".
# A escolha é EXPLÍCITA: setar D360_API_KEY sozinho NÃO troca o provedor
# (evita derrubar webhooks do Twilio em silêncio durante a migração).
WHATSAPP_PROVIDER=

# --- 360dialog (WhatsApp Business API via BSP) — futuro/multi-clínica --------
# Chave do canal (por clínica no modelo Partner). Base padrão já preenchida.
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# Token opcional para validar o webhook (?token=... ou header x-d360-token).
D360_WEBHOOK_TOKEN=

# --- Twilio WhatsApp --------------------------------------------------------
# Account SID: Twilio Console -> Account Info (começa com AC...).
TWILIO_ACCOUNT_SID=
# API Key SID: Twilio Console -> API Keys (começa com SK...).
TWILIO_API_KEY_SID=
# API Key Secret: gerado junto com o API Key SID.
TWILIO_API_KEY_SECRET=
# Seu número Twilio WhatsApp no formato "whatsapp:+14155238886".
TWILIO_WHATSAPP_FROM=
# Auth Token (Twilio Console -> Account Info): valida o X-Twilio-Signature do
# webhook em /api/whatsapp/webhook. Sem ele o webhook aceita POST sem validar.
TWILIO_AUTH_TOKEN=

# --- Zapier (automação) ------------------------------------------------------
# Use um trigger "Webhooks by Zapier -> Catch Hook" e cole a URL aqui.
ZAPIER_WEBHOOK_URL=
# Opcional: enviado no payload para você filtrar/validar dentro do Zap.
ZAPIER_SHARED_SECRET=

# --- Analytics / Ads (opcional) ---------------------------------------------
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas em BUILD TIME. Em produção
# precisam existir NO MOMENTO DO BUILD, não só em runtime.
# Sem elas => nenhum script de tracking carrega (o app funciona normal).
# GA4: crie a propriedade no Google Analytics e copie o Measurement ID.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: deixe vazio enquanto o Eduardo não configura o pixel.
NEXT_PUBLIC_META_PIXEL_ID=
