# ===== LeadBellus — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha.
# O app FUNCIONA SEM NENHUMA chave (modo demonstração): a UI roda, as respostas
# vêm de exemplos e os dados ficam salvos no navegador. Preencha para liberar o
# modo real (IA de verdade + login + dados na nuvem).
#
# --- Onde configurar (produção = VPS) ----------------------------------------
# Runtime (segredos): /opt/leadbellus/app.env no VPS — modelo em
# deploy/vps/app.env.example. NEXT_PUBLIC_* são build-time: vão nas Variables do
# GitHub usadas por .github/workflows/deploy-vps.yml. Runbook: deploy/vps/README.md.
# Os rótulos "Vercel"/"Cloud Run" abaixo são históricos (hosts desligados).

# --- IA (OpenAI / Anthropic / Gemini) — Cloud Run ---------------------------
# Ordem de uso no servidor: OpenAI -> Anthropic/Claude -> Gemini.
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com
# Gemini: https://aistudio.google.com/app/apikey
# Sem chave => respostas de exemplo (mock).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY também é aceito como alias de GEMINI_API_KEY.
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
# Lista em ordem de preferência: se um modelo der 503/429 (comum no tier grátis), tenta o próximo.
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Legado/compatível: ainda funciona quando *_MODEL não está definido.
AI_MODEL=

# --- NLP (leadvitta-nlp — classificação por ML) — Cloud Run ----------------
NLP_SERVICE_URL=
# Timeout (ms) antes de cair no classificador via LLM. Padrão 4000 no código.
NLP_SERVICE_TIMEOUT_MS=8000

# --- Clerk (login + sessão pública) -----------------------------------------
# Crie a aplicação em https://dashboard.clerk.com e configure os domínios.
# O app usa Clerk para login/cadastro e sincroniza uma sessão Firebase interna
# para manter Firestore, checkout e APIs legadas funcionando.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/configuracoes?onboarding=1

# --- Firebase (banco de dados + sessão interna) — Vercel + Cloud Run --------
# Cliente (Vercel build): NEXT_PUBLIC_FIREBASE_* abaixo.
# Admin (Cloud Run): FIREBASE_SERVICE_ACCOUNT_JSON ou ADC no serviço.
# O Firebase segue como sessão interna/Firestore para preservar checkout e APIs.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Emulador Firebase (dev local) ------------------------------------------
# true => Firestore/Auth apontam para 127.0.0.1:8080 / :9099 em vez do projeto
# real. `npm run dev:emulate` liga o flag e sobe os emuladores junto do Next.
# Requer Java 21+ no PATH (npm run firebase:emulator:check valida).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- Site — Vercel + Cloud Run --------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Proxy /api (legado da arquitetura Vercel + Cloud Run) ------------------
# Mantenha false: o VPS serve /api/* no mesmo processo, o Cloud Run não existe
# mais e o proxy quebra a ponte Clerk→Firebase.
ENABLE_API_PROXY=false
API_PROXY_ORIGIN=

# --- Stripe (checkout + webhook) — Cloud Run --------------------------------
# Lançamento: Start R$97/mês vendável; Pro/Premium em lista de espera.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_PRICE_ID_START=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_START_ANNUAL=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_PREMIUM_ANNUAL=
# Opcional: lista comma-separated de price_... permitidos (guard extra no checkout).
STRIPE_ALLOWED_PRICE_IDS=

# --- WhatsApp (Z-API — único provedor) — Cloud Run ------------------------
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_SECURITY_TOKEN=

# --- Alertas operacionais (signup, checkout, pagamento, lista de espera) ---
# Cada canal liga sozinho quando configurado; com os dois, envia pelos dois.
# E-mail via Resend (gratuito até 3.000/mês; domínio verificado no Resend).
RESEND_API_KEY=
# Vazio = suporte@leadbellus.com.br (lib/empresa.ts)
OPS_EMAIL_TO=
# Vazio = LeadBellus <alertas@leadbellus.com.br>
OPS_EMAIL_FROM=
# WhatsApp: exige também ZAPI_INSTANCE_ID/ZAPI_TOKEN.
OPS_WHATSAPP_NUMBER=

# --- Zapier (legado; ops preferem OPS_WHATSAPP_NUMBER) — Cloud Run ----------
ZAPIER_WEBHOOK_URL=
ZAPIER_SHARED_SECRET=

# --- Analytics / Ads — Vercel (build) + Cloud Run (GA4 server) --------------
# NEXT_PUBLIC_* = build-time na Vercel. Rebuild obrigatório ao mudar.
NEXT_PUBLIC_GA4_ID=
# Opcional no servidor: Secret do Measurement Protocol para espelhar
# begin_checkout/purchase sem depender do navegador. Nunca use NEXT_PUBLIC_.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Meta Pixel: deixe vazio enquanto o Eduardo não configura o pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Publicação automática na Meta (Página FB + Instagram) — Vercel ---------
# Token de Página com pages_manage_posts (+ instagram_content_publish p/ IG).
# Gere um token de longa duração no Meta Business Suite / Graph API Explorer.
# O cron diário (vercel.json -> /api/marketing/social-post) publica o
# calendário de data/social-posts.ts. Sem as vars, o cron vira no-op.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Secret exigido pelo cron (a Vercel envia Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# Número comercial público exibido no botão de WhatsApp da landing (com DDI,
# só dígitos, ex: 5591999999999). Vazio = botão não aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- HubSpot (CRM + Tracking para LeadBellus) — Vercel (build) --------------
# Portal ID público. LeadBellus (padrão): 51680733 → www.leadbellus.com.br
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=51680733
# Opcional (servidor): Private App access token para criar contatos/deals via API.
HUBSPOT_ACCESS_TOKEN=

# --- Supabase (espelho aditivo — FASE 1) — Vercel + Cloud Run --------------
# Firebase continua sendo fonte da verdade (Auth + Firestore).
# Supabase é mirror de leitura/escrita para histórico, waitlist etc.
# Link: https://supabase.com/dashboard/project/imlroxezgshrybizdnyy/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=
# Pode usar PUBLISHABLE_KEY (novo nome) ou ANON_KEY (clássico). Ambos funcionam.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional, somente servidor: recomendado para mirror/upserts que precisam furar RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Papel do deploy: web (default) | ai | billing | whatsapp | growth — ver services.yaml
# SERVICE_ROLE=web
