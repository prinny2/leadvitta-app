# ===== RespondeEstética IA — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha.
# O app FUNCIONA SEM NENHUMA chave (modo demonstração): a UI roda, as respostas
# vêm de exemplos e os dados ficam salvos no navegador. Preencha para liberar o
# modo real (IA de verdade + login + dados na nuvem).

# --- IA (OpenAI / Anthropic) ------------------------------------------------
# OpenAI: crie a chave em https://platform.openai.com/api-keys
# Anthropic: crie a chave em https://console.anthropic.com (Settings -> API Keys)
# Sem ela => respostas de exemplo (mock).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado para gerar as respostas (opcional).
# Se houver OpenAI, padrão = gpt-4o-mini. Sem OpenAI, padrão = claude-haiku-4-5.
AI_MODEL=gpt-4o-mini

# --- Firebase (login + banco de dados) --------------------------------------
# Crie um projeto em https://console.firebase.google.com e habilite:
#   Authentication (Email/Senha + Google) e Firestore Database.
# Project Settings -> General -> Your apps -> SDK setup: copie as chaves abaixo.
# Sem isso => login dispensado e dados salvos no navegador (modo demonstração).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor: Stripe webhook + Zapier autenticado)
# Na Vercel, prefira colar o JSON inteiro em FIREBASE_SERVICE_ACCOUNT_JSON
# ou usar a versão base64 se o painel/CLI escapar caracteres.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa por campos:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (checkout + webhook) --------------------------------------------
# Crie os produtos/preços no Stripe e copie os Price IDs (price_...).
# STRIPE_CHECKOUT_MODE=payment combina com os valores avulsos da landing.
# Use subscription se os Price IDs forem recorrentes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=payment
STRIPE_PRICE_ID_START=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- Zapier (automação) ------------------------------------------------------
# Use um trigger "Webhooks by Zapier -> Catch Hook" e cole a URL aqui.
ZAPIER_WEBHOOK_URL=
# Opcional: enviado no payload para você filtrar/validar dentro do Zap.
ZAPIER_SHARED_SECRET=

# --- Analytics / Ads (opcional) ---------------------------------------------
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas em BUILD TIME. Em produção
# (Vercel/Cloud Run) precisam existir NO MOMENTO DO BUILD, não só em runtime.
# Sem elas => nenhum script de tracking carrega (o app funciona normal).
# GA4: crie a propriedade no Google Analytics e copie o Measurement ID.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: deixe vazio enquanto o Eduardo não configura o pixel.
NEXT_PUBLIC_META_PIXEL_ID=
