# ===== RespondeEstética IA — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha.
# O app FUNCIONA SEM NENHUMA chave (modo demonstração): a UI roda, as respostas
# vêm de exemplos e os dados ficam salvos no navegador. Preencha para liberar o
# modo real (IA de verdade + login + dados na nuvem).

# --- IA (OpenAI / Anthropic / Gemini) ---------------------------------------
# Ordem de uso no servidor: OpenAI -> Anthropic/Claude -> Gemini.
# OpenAI: crie a chave em https://platform.openai.com/api-keys
# Anthropic: crie a chave em https://console.anthropic.com (Settings -> API Keys)
# Gemini: crie a chave em https://aistudio.google.com/app/apikey
# Sem ela => respostas de exemplo (mock).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY também é aceito como alias de GEMINI_API_KEY.
GOOGLE_API_KEY=
# Modelos opcionais por provedor. Em produção, prefira estes em vez de AI_MODEL
# para evitar que o fallback de outro provedor receba um modelo incompatível.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-2.5-flash
# Legado/compatível: ainda funciona quando *_MODEL não está definido.
AI_MODEL=

# --- NLP (leadvitta-nlp — classificação por ML) ------------------------------
# URL do microserviço leadvitta-nlp (FastAPI no Cloud Run). Quando definida, a
# classificação de intent/sentiment usa os modelos de ML reais; em qualquer
# falha/timeout cai no classificador via LLM. Sem ela => só LLM (comportamento
# atual). Dica: use --min-instances 1 no Cloud Run para evitar cold start
# (15-40s) na primeira chamada.
NLP_SERVICE_URL=
# Timeout (ms) da chamada ao serviço NLP antes de cair no fallback. Padrão 8000.
NLP_SERVICE_TIMEOUT_MS=8000

# --- Firebase (login + banco de dados) --------------------------------------
# Crie um projeto em https://console.firebase.google.com e habilite:
#   Authentication (Email/Senha + Google) e Firestore Database.
# Project Settings -> General -> Your apps -> SDK setup: copie as chaves abaixo.
# Auth oficial do v1 = Firebase Auth. Não existe fluxo Auth0 ativo neste repo.
# Sem isso => login dispensado e dados salvos no navegador (modo demonstração).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Chave PÚBLICA do par de chaves Web Push (FCM > Cloud Messaging > Certificados
# push da Web). Habilita as notificações no navegador. NÃO é a chave privada.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (servidor: Stripe webhook + Zapier autenticado)
# No Cloud Run, prefira a service account anexada ao serviço (ADC) para evitar
# manter um JSON longo em Secret Manager; fora do GCP, use as opções abaixo.
# Na Vercel/host externo, cole o JSON inteiro em FIREBASE_SERVICE_ACCOUNT_JSON
# ou use a versão base64 se o painel/CLI escapar caracteres/multiline.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa por campos:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Arquitetura híbrida Vercel + Cloud Run ---------------------------------
# Use no deploy do Vercel/frontend para mandar /api/* direto ao Cloud Run antes
# das rotas locais do Next. Não é segredo. Não use leadbellus.com.br aqui para
# evitar loop de proxy.
ENABLE_API_PROXY=false
API_PROXY_ORIGIN=https://leadbellus-87102725202.southamerica-east1.run.app

# --- Stripe (checkout + webhook) --------------------------------------------
# Crie os produtos/preços no Stripe e copie os Price IDs (price_...).
# Lançamento atual: Start R$97/mês disponível para venda.
# Pro e Premium ficam em lista de espera; configure os IDs deles só quando abrir.
# Todos os Price IDs usados aqui precisam ser "recurring" e o modo = subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_PRICE_ID_START=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- WhatsApp (Z-API — único provedor) ---------------------------------------
# Não-oficial: use número dedicado da clínica; risco de ban se abusar.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Header Client-Token nas chamadas à API (painel Z-API).
ZAPI_CLIENT_TOKEN=
# Valida webhook (?token=... ou header x-zapi-token).
ZAPI_SECURITY_TOKEN=

# --- Alertas operacionais (Z-API — substitui Zapier) -------------------------
# Número que recebe WhatsApp quando há signup, checkout ou waitlist (só dígitos).
# Ex.: 559185156690 (linha LeadBellus) ou seu celular pessoal.
OPS_WHATSAPP_NUMBER=

# --- Analytics / Ads (opcional) ---------------------------------------------
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas em BUILD TIME. Em produção
# precisam existir NO MOMENTO DO BUILD, não só em runtime.
# Sem elas => nenhum script de tracking carrega (o app funciona normal).
# GA4: copie o "ID da métrica" do fluxo Web, no formato G-XXXXXXXXXX.
# Não use o "Código do fluxo" numérico; ele não funciona na tag gtag.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: deixe vazio enquanto o Eduardo não configura o pixel.
NEXT_PUBLIC_META_PIXEL_ID=
