# /opt/leadbellus/app.env — segredos de RUNTIME do LeadBellus no VPS.
# chmod 600, dono "deploy". NUNCA commitar o arquivo preenchido.
# Formato do docker compose: CHAVE=valor, uma por linha, sem aspas, sem multi-linha.
# Nomes completos e comentários: .env.local.example na raiz do repo.

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.leadbellus.com.br

# --- Firebase (Firestore + sessão interna) — plano Spark, sem billing ---------
# Firebase console → Configurações do projeto → Contas de serviço → Gerar chave.
# Converta o JSON em uma linha:  base64 -i chave.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=leadvitta-app

# --- IA (defina limite de gasto mensal no painel de cada provedor) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Produção hoje roda só com Gemini (tier gratuito do AI Studio, chave de um projeto
# SEM faturamento — não cobra). Lista de modelos = fallback quando um está lotado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# --- Stripe (LIVE) --------------------------------------------------------------
STRIPE_SECRET_KEY=
# whsec_ do endpoint https://www.leadbellus.com.br/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_PRICE_ID_START=

# --- Alertas operacionais (signup, checkout, pagamento, lista de espera) ---------
# E-mail via Resend (plano gratuito, 3.000/mês): resend.com → API Keys.
# O domínio leadbellus.com.br precisa estar verificado no Resend (DNS no Registro.br).
RESEND_API_KEY=
# Destino; vazio = suporte@leadbellus.com.br (lib/empresa.ts)
OPS_EMAIL_TO=
# Remetente; vazio = LeadBellus <alertas@leadbellus.com.br>
OPS_EMAIL_FROM=

# --- Opcionais ------------------------------------------------------------------
# Posts automáticos FB/IG (cron diário do bootstrap.sh)
CRON_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# GA4 server-side
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Clerk — desligado no relançamento: sem estas chaves o login é o Firebase Auth.
# Se religar, a NEXT_PUBLIC_ também vai nas Variables do GitHub (build-time).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# WhatsApp (Z-API) — desligado; preencher só se reativar a assinatura.
# OPS_WHATSAPP_NUMBER = número que recebe os alertas também por WhatsApp.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_SECURITY_TOKEN=
OPS_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API opcional. Requer WABA/Phone Number configurados no Meta.
# WHATSAPP_PROVIDER=meta-cloud seleciona este canal de entrada/saída manual.
WHATSAPP_PROVIDER=zapi
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_DISPLAY_PHONE_NUMBER=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=
